# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Ephemeral Redis Configuration
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=900

# Permanent Shop Identity + Auth (persistent, NOT ephemeral)
# SQLite file that stores users/shops/memberships/device-sessions/auth-sessions.
# It MUST NOT ever store document bytes.
IDENTITY_DB_PATH=./data/quickdrop.db
# Secret used to sign the HttpOnly auth-session cookie. REQUIRED in production.
COOKIE_SECRET=change-me-in-production-use-a-long-random-string
# Auth-session (owner login) lifetime, in seconds. Default 30 days.
AUTH_SESSION_TTL_SECONDS=2592000
# Login brute-force protection (per IP, per minute).
AUTH_RATE_LIMIT_MAX_PER_MINUTE=10

# STUN / TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Transfer & Security Limits
MAX_FILE_SIZE_BYTES=52428800
MAX_SESSION_BYTES=209715200
MAX_FILES_PER_SESSION=20
